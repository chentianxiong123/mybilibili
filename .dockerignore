# Git / IDE
.git
.gitignore
.idea
.vscode
*.swp
.DS_Store

# Go 编译产物 / 本地二进制
**/mybilibili-core
**/mybilibili-msg-danmaku
**/mybilibili-ai
**/mybilibili-search
**/mybilibili-live
**/mybilibili-studio
