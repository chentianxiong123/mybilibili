# ============================================================
#  【开发机】敏感配置模板（docker compose 专用）
#  复制: cp deploy/.env.example deploy/.env 然后填实际值
#  非敏感 + 基础设施地址已收敛到 deploy/k3s/base/config/common.env + dev.env
#  此文件只放不同环境必须不同的敏感项（env_file 按序加载覆盖）
# ============================================================

# 认证密钥（生产务必改！）
JWT_SECRET=dev-secret-change-in-production

# MinIO 访问凭据（必须带协议前缀的用法：core 用 url.Parse 反代 /uploads）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# B站 SESSDATA（可选，填了提升清晰度档位，留空仍可用 720p/360p）
BILI_SESSDATA=