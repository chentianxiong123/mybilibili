# ====== mybilibili 后端容器编排配置模板 ======
# 用法: cp deploy/.env.example deploy/.env 然后填实际值
# compose 文件 env_file 引用 deploy/.env；k3s 阶段拆分为 ConfigMap(非敏感)+Secret(敏感)

# ---------- 基础设施连接（容器网络内用容器名，不要用 localhost）----------
# PostgreSQL
PG_DSN=postgres://postgres:postgres@pg16:5432/mybilibili?sslmode=disable
# Redis
REDIS_ADDR=mybilibili-redis:6379
# NATS 消息队列
NATS_URL=nats://nats:4222
MQ_TYPE=nats

# ---------- 认证密钥（生产务必改！k3s 阶段进 Secret）----------
JWT_SECRET=dev-secret-change-in-production

# MinIO 对象存储（必须带协议前缀，core 用它 url.Parse 反代 /uploads）
MINIO_ENDPOINT=http://mybilibili-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mybilibili

# ---------- 服务间 gRPC（容器名:端口，core 调下游服务）----------
AI_GRPC_ADDR=ai:9088
MSG_DANMAKU_GRPC_ADDR=msg-danmaku:9086
SEARCH_GRPC_ADDR=search:9084
SEARCH_SERVICE_ADDR=search:9084

# ---------- B站代理 ----------
# BILI_SESSDATA 可选，填了能提升播放清晰度档位（留空仍可用 720p/360p）
BILI_SESSDATA=
# core 反代 bili 的地址（容器内用服务名）
BILI_PROXY_ADDR=http://bili:8091

# ---------- 转码（transcoder 裸跑宿主机 + work 容器编排）----------
WORK_DIR=/data/work
# work 调 transcoder 的地址：transcoder 裸跑宿主机，
# 用宿主机系统 ffmpeg + 对应显卡驱动（零容器驱动），work 容器经 mylib 网关访问。
TRANSCODER_ADDR=http://172.18.0.1:8092
# 转码编码器: auto(探测VAAPI) / soft(软编) / vaapi(强制硬编)
TRANSCODE_ENCODER=auto

# ---------- studio 数据目录 ----------
STUDIO_DATA_DIR=/data/studio

# ---------- 日志 ----------
LOG_LEVEL=info
