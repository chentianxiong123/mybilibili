# ============================================================
#  mybilibili 公共配置（开发机 / 部署机 一致的值，非敏感）
#  按环境差异的变量见 dev.env / prod.env
#  敏感项（JWT_SECRET/MINIO_ACCESS_KEY/MINIO_SECRET_KEY）:
#    compose 走 deploy/.env，k3s 走 base/secret.yaml，勿放这里
# ============================================================

# 日志级别
LOG_LEVEL=info

# 消息队列类型
MQ_TYPE=nats

# MinIO 存储桶
MINIO_BUCKET=mybilibili

# 服务间 gRPC / HTTP 下游地址（compose 容器名即 k3s Service 名，两端一致）
AI_GRPC_ADDR=ai:9088
MSG_DANMAKU_GRPC_ADDR=msg-danmaku:9086
SEARCH_GRPC_ADDR=search:9084
SEARCH_SERVICE_ADDR=search:8084
BILI_PROXY_ADDR=http://bili:8091
LIVE_SERVICE_ADDR=live:8087

# 数据目录
WORK_DIR=/tmp/work
STUDIO_DATA_DIR=/data/studio