# ============================================================
#  【开发机】差异配置（docker compose 专用）
#  基础设施连接用 compose 容器名（pg16/myBilibili-redis/...）
#  应用环境: docker compose -f deploy/docker-compose.yml up -d
# ============================================================

# PostgreSQL（compose 服务 pg16）
PG_DSN=postgres://postgres:postgres@pg16:5432/mybilibili?sslmode=disable
# Redis（compose 服务 mybilibili-redis）
REDIS_ADDR=mybilibili-redis:6379
# NATS（compose 服务 nats）
NATS_URL=nats://nats:4222
# MinIO（compose 服务 mybilibili-minio）
MINIO_ENDPOINT=http://mybilibili-minio:9000
# 转码服务（transcoder 裸跑宿主机，compose 容器经 docker 网关 172.18.0.1 访问）
TRANSCODER_ADDR=http://172.18.0.1:8092
# 转码编码器: auto(探测VAAPI) / soft(软编) / vaapi(强制硬编)
TRANSCODE_ENCODER=auto