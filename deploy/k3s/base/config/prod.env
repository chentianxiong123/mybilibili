# ============================================================
#  【部署机】差异配置（fnos k3s 专用）
#  基础设施连接用 k3s Service 名（postgres/redis/minio/nats）
#  部署机: fnos (192.168.31.225)
#  应用环境: kubectl apply -k deploy/k3s/overlays/prod
# ============================================================

# PostgreSQL（k3s Service postgres）
PG_DSN=postgres://postgres:postgres@postgres:5432/mybilibili?sslmode=disable
# Redis（k3s Service redis）
REDIS_ADDR=redis:6379
# NATS（k3s Service nats）
NATS_URL=nats://nats:4222
# MinIO（k3s Service minio）
MINIO_ENDPOINT=http://minio:9000
# 转码服务（transcoder 裸跑部署机宿主机，k3s pod 经部署机 IP 访问）
TRANSCODER_ADDR=http://192.168.31.225:8092
# 转码编码器: auto(探测VAAPI) / soft(软编) / vaapi(强制硬编)
TRANSCODE_ENCODER=auto