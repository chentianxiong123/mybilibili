<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mybilibili.web.mapper.CreatorSettingsMapper">

    <resultMap id="CreatorSettingsMap" type="com.mybilibili.common.entity.CreatorSettings">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="default_category_id" property="defaultCategoryId"/>
        <result column="auto_publish" property="autoPublish"/>
        <result column="comment_notify" property="commentNotify"/>
        <result column="like_notify" property="likeNotify"/>
        <result column="follow_notify" property="followNotify"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <resultMap id="CreatorSettingsVOMap" type="com.mybilibili.common.vo.CreatorSettingsVO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="default_category_id" property="defaultCategoryId"/>
        <result column="auto_publish" property="autoPublish"/>
        <result column="comment_notify" property="commentNotify"/>
        <result column="like_notify" property="likeNotify"/>
        <result column="follow_notify" property="followNotify"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.mybilibili.common.entity.CreatorSettings" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO creator_settings (user_id, default_category_id, auto_publish, comment_notify, like_notify, follow_notify, created_at, updated_at)
        VALUES (#{userId}, #{defaultCategoryId}, #{autoPublish}, #{commentNotify}, #{likeNotify}, #{followNotify}, NOW(), NOW())
    </insert>

    <select id="selectById" parameterType="java.lang.Integer" resultMap="CreatorSettingsMap">
        SELECT * FROM creator_settings WHERE id = #{id}
    </select>

    <select id="selectByUserId" parameterType="java.lang.Integer" resultMap="CreatorSettingsMap">
        SELECT * FROM creator_settings WHERE user_id = #{userId}
    </select>

    <select id="selectVOByUserId" parameterType="java.lang.Integer" resultMap="CreatorSettingsVOMap">
        SELECT * FROM creator_settings WHERE user_id = #{userId}
    </select>

    <update id="update" parameterType="com.mybilibili.common.entity.CreatorSettings">
        UPDATE creator_settings
        SET default_category_id = #{defaultCategoryId},
            auto_publish = #{autoPublish},
            comment_notify = #{commentNotify},
            like_notify = #{likeNotify},
            follow_notify = #{followNotify},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM creator_settings WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId" parameterType="java.lang.Integer">
        DELETE FROM creator_settings WHERE user_id = #{userId}
    </delete>

</mapper>
