server {
    listen 3100;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    # base=/admin/ 的 SPA
    location /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }
    location = /admin { return 301 /admin/; }

    # 后端反代（默认 core:8080，可用 CORE_ADDR 覆盖）
    location /api/v1/search/ {
        proxy_pass http://${CORE_ADDR:-core:8080}/api/v1/search/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/v1/recommend/ {
        proxy_pass http://${CORE_ADDR:-core:8080}/api/v1/recommend/;
        proxy_set_header Host $host;
    }
    location /api/v1/ai {
        proxy_pass http://${AI_ADDR:-ai:8088}/api/v1/ai;
        proxy_set_header Host $host;
    }
    location /api/v1/subtitle {
        proxy_pass http://${AI_ADDR:-ai:8088}/api/v1/subtitle;
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://${CORE_ADDR:-core:8080}/api/;
        proxy_set_header Host $host;
    }
    location /uploads/ {
        proxy_pass http://${CORE_ADDR:-core:8080}/uploads/;
        proxy_set_header Host $host;
    }
    location /covers/ {
        proxy_pass http://${CORE_ADDR:-core:8080}/covers/;
        proxy_set_header Host $host;
    }
    location /videos/ {
        proxy_pass http://${CORE_ADDR:-core:8080}/videos/;
        proxy_set_header Host $host;
    }
}
