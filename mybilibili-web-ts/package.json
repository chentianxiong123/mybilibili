{
  "name": "mybilibili-web-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "dev:admin": "vite --mode admin",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build --mode web",
    "build:admin": "vite build --mode admin",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tanstack/vue-virtual": "^3.13.35",
    "artplayer": "^5.1.6",
    "artplayer-plugin-danmuku": "^5.1.4",
    "axios": "^1.7.2",
    "echarts": "^5.6.0",
    "element-plus": "^2.7.5",
    "flv.js": "^1.6.2",
    "hls.js": "^1.5.13",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass": "^1.77.5",
    "vue": "^3.5.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vite-plugin-vue-devtools": "^7.0.18",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.3.10"
  }
}