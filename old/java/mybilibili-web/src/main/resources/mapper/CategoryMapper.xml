<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mybilibili.web.mapper.CategoryMapper">
    <select id="selectAll" resultType="com.mybilibili.common.entity.Category">
        SELECT * FROM categories ORDER BY id
    </select>

    <select id="selectById" parameterType="java.lang.Integer" resultType="com.mybilibili.common.entity.Category">
        SELECT * FROM categories WHERE id = #{id}
    </select>
</mapper>